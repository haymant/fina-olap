# --- fina-olap engine / server ----------------------------------------------
# FINA_OLAP_FIXTURE=/abs/path/to/sample.parquet   # explicit fixture location

# --- storage backend switch + partition config --------------------------------
# FINA_OLAP_STORE=auto          # local | s3 | gcs | auto (default). s3/gcs force
#                               # the object-store branch (fail loudly when
#                               # unconfigured, no silent fixture fallback).
# FINA_OLAP_PARQUET_ROOT=/abs/path   # local parquet root (aliases: OLAP_PARQUET_ROOT, DATA_DIR)
# FINA_OLAP_BUCKET=             # object-store bucket (aliases: S3_BUCKET_NAME, AWS_BUCKET; gcs: GCS_BUCKET_NAME)
# FINA_OLAP_PATH=               # default prefix under the bucket (alias: S3_PATH_ENV)
# S3_PATH_TEMPLATE={bucket}/{s3Path}/{version}/{slice}/{tableName}*.parquet
# FINA_OLAP_PARTITION_GLOB={tableName}*.parquet  # on-store layout, e.g. {tableName}/region=*/date=*/*.parquet
# FINA_OLAP_HIVE_PARTITIONING=  # 1|0 — hive-partition column discovery; default: on for s3/gcs, off for local
#
# The same settings can be changed at runtime via the MCP tools store_config /
# store_configure / store_resolve (process-local overrides, reset with clear=true).

# --- upsert / export ----------------------------------------------------------
# upsert_store(table_name, key, rows|file_path|data_format, appender, chunk_size)
# merges CSV/JSON/Parquet rows into the store keyed on `key` (match -> update,
# new -> insert, store rewritten). appender=true + chunk_size write via a pyarrow
# ParquetWriter chunk by chunk (one row group per chunk; flat local stores only).
# store_export(table_name, out_path, data_format=csv|json|jsonl|parquet,
#              columns, filters=ag-grid filterModel, limit) filters + dumps the store.

# --- object store (DuckDB httpfs S3 secret) ----------------------------------
# GCS-style (S3 interop):
# S3_API_KEY=
# S3_API_SECRET=
# S3_ENDPOINT=storage.googleapis.com
# AWS-style:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL=
# AWS_REGION=auto

# --- MCP / server ------------------------------------------------------------
# ALLOWED_HOSTS=localhost,127.0.0.1,fina-olap.vercel.app
# CORS_ORIGINS=*