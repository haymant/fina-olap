{
  "name": "fina-table",
  "version": "0.2.0",
  "description": "Self-contained React table for ag-grid Server-Side Row Model OLAP engines (fina-olap) — remembered grouping, infinite scroll, dark/light themes, per-level aggregations and a 4-panel config dropdown.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "ag-grid",
    "ssrm",
    "olap",
    "react",
    "table",
    "duckdb",
    "parquet",
    "lod",
    "pivot",
    "infinite-scroll",
    "grouping",
    "theme"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "dayjs": ">=1.11",
    "echarts": ">=5"
  },
  "peerDependenciesMeta": {
    "dayjs": {
      "optional": true
    },
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
